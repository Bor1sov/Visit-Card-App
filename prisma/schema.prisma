datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

model Profile {
    id    Int    @id @default(autoincrement())
    name  String
    description String
    github String
    linkedin String?
    skills Skill[]
    experiences Experience[]
    projects Project[]
}

model Skill {
    id   Int   @id @default(autoincrement())
    name String
    profile Profile @relation(fields: [profileId], references: [id])
    profileId Int
}

model Experience {
    id             Int    @id @default(autoincrement())
    company        String
    position       String
    startDate      DateTime
    endDate        DateTime?
    achievements   String
    profile Profile @relation(fields: [profileId], references: [id])
    profileId Int
}

model Project {
    id   Int    @id @default(autoincrement())
    name String
    profile Profile @relation(fields: [profileId], references: [id])
    profileId Int
    link  String
}

